# Copy to .env and fill in. .env itself is gitignored and must stay that way —
# it was tracked once and is deliberately untracked now.

# Sanity, read by src/sanity/client.js for the Floorplan view's CMS content.
# Must also be set in Vercel; without them the view falls back to the plans
# bundled in src/lib/floorplans.js.
# Project id and dataset are not secrets on their own; a write token would be,
# so do not add one here.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Supabase, read by src/lib/supabase.js — visitor analytics (floor/unit
# selections, page views, click heatmap, visitor locations) and the /admin
# dashboard. Both values are public by design: the publishable key ships in the
# browser bundle, and the database's grants/RLS are what protect the data.
# Without them the site still runs, but nothing is recorded and /admin shows
# "Admin unavailable". Set the same two in Vercel > Project Settings >
# Environment Variables, or production records nothing either.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# MapTiler, read by the Location map. Optional — the map falls back to the
# keyless OpenFreeMap style without it.
VITE_MAPTILER_KEY=

# Vercel Blob, read by api/hostSheet.js — the only one of these that is a real
# secret, and the only one with no fallback. It is what hosts the visitor's
# generated sheet at a public URL so the QR code has something to point at.
#
# Without it `put()` throws, /api/upload answers 500, and the QR button does
# nothing at all: the failure is caught and logged, so the only sign on screen
# is that no code appears. If the QR is "not working", check this first.
#
# No VITE_ prefix, deliberately — this must never reach the browser bundle.
# Get it from Vercel > Storage > your Blob store > Tokens, and set the same
# value in Project Settings > Environment Variables, or the hosted site fails
# the same way this one does. Restart the dev server after adding it;
# vite.config.js only reads it at startup.
BLOB_READ_WRITE_TOKEN=
